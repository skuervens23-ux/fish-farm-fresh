# ---------------------------------------------------------------------------
# Pond Purchase Hub — contoh environment variable
# Salin file ini menjadi .env lalu isi dengan nilai proyek Supabase Anda.
# JANGAN pernah commit file .env yang sudah terisi.
# ---------------------------------------------------------------------------

# --- Supabase (wajib) ------------------------------------------------------
# Nilai untuk sisi server (SSR / server function / server route)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="<project-ref>"

# Nilai yang sama, di-inline ke bundle browser oleh Vite (harus prefix VITE_)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- Supabase service role (opsional, hanya server) ------------------------
# Dipakai hanya bila Anda menjalankan operasi admin yang melewati RLS.
# Rahasia penuh: jangan pernah diekspos ke browser.
# SUPABASE_SERVICE_ROLE_KEY=""

# --- Fitur AI (opsional) ---------------------------------------------------
# Endpoint chat (/api/chat) memakai gateway yang kompatibel OpenAI.
# Tanpa kunci ini, seluruh aplikasi tetap jalan; hanya menu "Tanya AI" nonaktif.
# LOVABLE_API_KEY=""
